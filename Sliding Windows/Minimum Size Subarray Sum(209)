class Solution {
public:
    int minSubArrayLen(int target, vector<int>& nums) {
        int n = nums.size();
        int low =0,high =0;
        int minLen = INT_MAX;
        int sum =0;
        while(high < n){
            sum = sum + nums[high];
            while(sum >= target){
                int Len = high-low+1;
                minLen = min(minLen,Len);
                sum = sum - nums[low];
                low++;
            }
            high++;
        }
        return (minLen == INT_MAX)?0:minLen;
    }
};
