class Solution {
public:
    int totalFruit(vector<int>& fruits) {
        int n = fruits.size();
        vector<int> hashmap(n,0);
        int low=0, high=0;
        int maxLen=0;
        int unique=0;
        while(high < n){
            if(hashmap[fruits[high]]==0){
                unique++;
            }
            hashmap[fruits[high]]++;
            while(unique > 2){
                hashmap[fruits[low]]--;
                if(hashmap[fruits[low]]==0){
                    unique--;
                }
                low++;
            }
            maxLen = max(maxLen, high-low+1);
            high++;
        }
        return maxLen;
    }
};
