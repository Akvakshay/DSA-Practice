class Solution {
public:
    vector<vector<int>> insert(vector<vector<int>>& intervals, vector<int>& newInterval) {
        if (intervals.empty()) return {newInterval}; // Edge case handling

        vector<vector<int>> res;
        bool inserted = false;
        int n = intervals.size();

        // Step 1: Insert newInterval in the correct sorted position
        for(int i = 0; i < n; i++){
            int start = intervals[i][0];
            if(inserted == false && start >= newInterval[0]){
                res.push_back(newInterval);
                inserted = true;
            }
            res.push_back(intervals[i]);
        }
        if(inserted == false){
            res.push_back(newInterval);
        }

        // Step 2: Merge overlapping intervals
        vector<vector<int>> res2;
        int n1 = res.size();
        int start1 = res[0][0];
        int end1 = res[0][1];

        for(int i = 1; i < n1; i++){
            int start2 = res[i][0];
            int end2 = res[i][1];

            if(end1 >= start2){
                // OVERLAP: Keep start1 as is, take the max end
                end1 = max(end1, end2); 
            } else {
                // NO OVERLAP: Push the finalized interval and start a new one
                res2.push_back({start1, end1});
                start1 = start2;
                end1 = end2;
            }
        }
        // Push the very last interval being tracked
        res2.push_back({start1, end1}); 
        
        return res2;
    }
};
