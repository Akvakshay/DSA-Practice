class Solution {
public:
    long long maximumSubarraySum(vector<int>& nums, int k) {
        int n = nums.size();
        unordered_map<int, int> counts;
        long long current_sum = 0;
        long long max_sum = 0;

        for (int i = 0; i < n; i++) {
            // Add the current element to the window
            current_sum += nums[i];
            counts[nums[i]]++;

            // Once the window exceeds size k, remove the leftmost element
            if (i >= k) {
                int left_val = nums[i - k];
                current_sum -= left_val;
                counts[left_val]--;
                
                // Clean up the map to keep size() accurate
                if (counts[left_val] == 0) {
                    counts.erase(left_val);
                }
            }

            // Check if the window is exactly size k and all elements are distinct
            if (i >= k - 1) {
                if (counts.size() == k) {
                    max_sum = max(max_sum, current_sum);
                }
            }
        }

        return max_sum;
    }
};
