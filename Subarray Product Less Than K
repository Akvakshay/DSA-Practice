class Solution {
public:
    int numSubarrayProductLessThanK(vector<int>& nums, int k) {
        // If k is 1 or less, no product of positive integers can be strictly less than k.
        if (k <= 1) {
            return 0;
        }
        
        int low = 0;
        int n = nums.size();
        long long pro = 1; // Use long long to prevent integer overflow during multiplication
        int res = 0;
        
        for (int high = 0; high < n; high++) {
            // Include the current element in our running product
            pro = pro * nums[high];
            
            // If the product is too large, shrink the window from the left
            while (pro >= k && low <= high) {
                pro = pro / nums[low];
                low++;
            }
            
            // Add the number of valid subarrays ending at the current 'high' index
            res += (high - low + 1);
        }
        
        return res;
    }
};
