class Solution {
public:
    int removeDuplicates(vector<int>& nums) {
        int i=0,k=1,j=1;
        int length = nums.size();
        while(j<length){
            if(nums[j]==nums[j-1]){
                j++;
                continue;
            }
            nums[i+1]=nums[j];
            i++;
            k++;
            j++;
        }
        return k;
    }
};
