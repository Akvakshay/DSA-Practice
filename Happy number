class Solution {
public:
     int getNext(int num){
        int sum=0;
        while(num>0){
            int digit=num%10;
            sum = sum+digit*digit;
            num = num/10;
        }
        return sum;
    }
    bool isHappy(int n) {
        int slow =n;
        int fast =n;
        while(fast!=1){
            slow=getNext(slow);
            fast=getNext(getNext(fast));
            if(slow==fast && slow!=1){
                return false;
            }
        }
        return true;
    }
};
