class Solution {
public:
    int totalFruit(vector<int>& fruits) {
        unordered_map<int, int> f;
        int n = fruits.size();
        int low = 0, res = 0;

        for (int high = 0; high < n; high++) {
            f[fruits[high]]++;

            // If we have more than 2 types of fruit, shrink the window
            while (f.size() > 2) {
                f[fruits[low]]--;
                
                // Check if the COUNT of this fruit reached zero
                if (f[fruits[low]] == 0) {
                    f.erase(fruits[low]);
                }
                low++; // Move the left pointer forward
            }

            // Calculate window size: all fruits in the current valid range
            res = max(res, high - low + 1);
        }
        return res;
    }
};
