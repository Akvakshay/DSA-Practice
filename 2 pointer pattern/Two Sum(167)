class Solution {
public:
    vector<int> twoSum(vector<int>& nums, int target) {
        int length = nums.size();
       // sort(nums.begin(), nums.end());
        int left = 0, sum =0;
        int right = length - 1;
        while(left<right){
            sum = nums[left] + nums[right];
            if(sum == target){
               return {left+1,right+1};
            }
            else if (sum < target){
                left++;
            }
            else{
                right--;
            }
        }
        return {};
    }
};
