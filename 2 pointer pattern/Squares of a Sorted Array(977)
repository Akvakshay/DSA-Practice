class Solution {
public:
    vector<int> sortedSquares(vector<int>& nums) {
        int n = nums.size();
        vector<int> posi, neg;

        for (int i = 0; i < n; i++) {
            if (nums[i] < 0) {
                neg.push_back(nums[i]);
            } else {
                posi.push_back(nums[i]);
            }
        }
        if (neg.size() == 0) {
            for (int i = 0; i < posi.size(); i++) {
                posi[i] = posi[i] * posi[i];
            }
            return posi;
        }
        if (posi.size() == 0) {
            for (int i = 0; i < neg.size(); i++) {
                neg[i] = neg[i] * neg[i];
            }
            reverse(neg.begin(),neg.end());
            return neg;
        }

        int i = 0, j = 0;
        int id = 0;
        int x = neg.size();
        int y = posi.size();
        vector<int> res(x + y);
        for (int k = 0; k < x; k++) {
            neg[k] = neg[k] * neg[k];
        }
        reverse(neg.begin(), neg.end());

        for (int k = 0; k < y; k++) {
            posi[k] = posi[k] * posi[k];
        }

        while (i < x && j < y) {
            if (neg[i] <= posi[j]) {
                res[id] = neg[i];
                id++;
                i++;
            } else {
                res[id] = posi[j];
                id++;
                j++;
            }
        }
        while (i < x) {
            res[id] = neg[i];
            id++;
            i++;
        }
        while (j < y) {
            res[id] = posi[j];
            id++;
            j++;
        }
        return res;
    }
};
